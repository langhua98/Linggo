# ── 必填 ─────────────────────────────────────────────
# https://my.telegram.org → API development tools 申请
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# @BotFather 创建机器人拿到的 token；机器人要加进私有频道并设为管理员（要有发消息、删消息权限）
TELEGRAM_BOT_TOKEN=
# 私有频道 ID，形如 -1001234567890
TELEGRAM_CHAT_ID=
# 随机长字符串，用来签登录令牌：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 第一次启动时自动创建的管理员（已有用户后不再使用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# docker-compose 里 PostgreSQL 的密码
POSTGRES_PASSWORD=

# ── 可选 ─────────────────────────────────────────────
# 按类型分到不同频道（第四阶段：多频道）。没列出的类型进 TELEGRAM_CHAT_ID
# 类型：video image audio document archive other
# TELEGRAM_CHAT_ROUTES=video=-1001111111111,image=-1002222222222
# 走 HTTPS 部署时设为 true（登录 Cookie 只在 HTTPS 下发送）
COOKIE_SECURE=false
# 单文件上限（MB）。机器人走 MTProto 最大 2000
MAX_FILE_SIZE_MB=2000
# 浏览器分片大小（MB）。前面有 Nginx 的话 client_max_body_size 要比它大
CHUNK_SIZE_MB=8
# Worker 同时往 Telegram 传几个文件
UPLOAD_CONCURRENCY=2
# 失败几次后标记为失败
MAX_RETRIES=3
# 失败 / 中断的上传，服务器临时文件保留多少小时
STAGING_TTL_HOURS=72
SESSION_DAYS=30
# 开发用：local = 不连 Telegram，文件存在 data/local_store 里
# STORAGE_BACKEND=telegram
