{
  "name": "小橘视频 · 云电脑（MediaCrawler）",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": { "label": "网页桌面（扫码登录抖音，密码 vscode）" }
  },
  "postCreateCommand": "bash xiaoju-video/cloud/run.sh install"
}
